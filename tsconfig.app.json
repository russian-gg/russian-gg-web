{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // The admin panel was outside the type check, so `npm run build:admin` compiled it with
  // esbuild and never once checked a type in it. It ships to an operator making decisions
  // about money; it gets the same bar as the learner app.
  "include": ["src", "src-admin"]
}
