FROM node:22-alpine AS build
WORKDIR /app

ARG VITE_ADMIN_STORAGE_PREFIX=rgg.stage.admin
ENV VITE_ADMIN_STORAGE_PREFIX=$VITE_ADMIN_STORAGE_PREFIX

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:admin
# The maps are written but never shipped. `sourcemap: 'hidden'` keeps them out of the browser
# by emitting no sourceMappingURL, and this keeps them off the server entirely — a map is
# still readable to anyone who guesses its URL.
RUN find dist-admin -name '*.map' -delete

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist-admin /usr/share/nginx/html
COPY nginx.admin.stage.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
